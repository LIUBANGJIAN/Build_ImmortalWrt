# =========================================================================
# x86_64 架构全能编译配置文件 (全中文注解：集成插件 + 全套物理/虚拟网卡驱动)
# =========================================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 固件压缩格式选项
CONFIG_TARGET_IMAGES_GZIP=y

# =========================================================================
# 一、 核心功能与基础系统、诊断工具
# =========================================================================
CONFIG_SING_BOX_WITH_ECH=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_open-vm-tools=y        # VMware 虚拟机工具与剪贴板支持
CONFIG_PACKAGE_iperf3=y               # 网络测速工具
CONFIG_PACKAGE_iftop=y                # 实时流量监控
CONFIG_PACKAGE_tcpdump=y              # 抓包工具
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_htop=y                 # 进程管理
CONFIG_PACKAGE_bc=y                   # 命令行计算器
CONFIG_PACKAGE_sudo=y                 # sudo 命令支持
CONFIG_PACKAGE_pciutils=y             # PCI 设备查看
CONFIG_PACKAGE_usbutils=y             # USB 设备查看
CONFIG_PACKAGE_cfdisk=y               # 磁盘分区工具
CONFIG_PACKAGE_ethtool-full=y         # 网卡高级参数设置工具

# =========================================================================
# 二、 网络与组网插件 (WireGuard + Netbird)
# =========================================================================
CONFIG_PACKAGE_netbird=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# =========================================================================
# 三、 常用应用与扩展插件
# =========================================================================
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-ttyd=y         # 网页终端
CONFIG_PACKAGE_luci-app-taskplan=y     # 计划任务面板
CONFIG_PACKAGE_luci-app-rtp2httpd=y  # IPTV 组播转单播
CONFIG_PACKAGE_luci-app-frps=y       # 内网穿透客户端
CONFIG_PACKAGE_luci-app-fileassistant=y # 文件助手
CONFIG_PACKAGE_luci-app-firewall=y     # 防火墙
CONFIG_PACKAGE_luci-app-netdata=y      # Netdata 实时监控
CONFIG_PACKAGE_luci-app-socat=y        # Socat 网络工具
CONFIG_PACKAGE_luci-app-turboacc=y     # Turbo ACC 网络加速

# =========================================================================
# 四、 物理机与全虚拟化网卡/磁盘驱动清单 (完美支持物理机、VMware、PVE/KVM、Hyper-V)
# =========================================================================
# 1. 常见物理机网卡驱动
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y
CONFIG_PACKAGE_kmod-alx=y
CONFIG_PACKAGE_kmod-amazon-ena=y
CONFIG_PACKAGE_kmod-amd-xgbe=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-bnx2x=y
CONFIG_PACKAGE_kmod-e1000=y           # Intel 千兆网卡驱动
CONFIG_PACKAGE_kmod-e1000e=y          # Intel 常见台式机/软路由千兆网卡驱动
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-i40e=y            # Intel 40G 网卡驱动
CONFIG_PACKAGE_kmod-iavf=y
CONFIG_PACKAGE_kmod-igb=y             # Intel 高性能千兆网卡驱动
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-igc=y             # Intel 2.5G 高速网卡驱动 (如 i226/i225)
CONFIG_PACKAGE_kmod-ixgbe=y           # Intel 万兆网卡驱动
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y
CONFIG_PACKAGE_kmod-net-selftests=y
CONFIG_PACKAGE_kmod-pcnet32=y
CONFIG_PACKAGE_kmod-phy-ax88796b=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-phy-smsc=y
CONFIG_PACKAGE_kmod-r8125=y           # Realtek 2.5G 网卡驱动
CONFIG_PACKAGE_kmod-r8152=y           # Realtek USB 网卡驱动
CONFIG_PACKAGE_kmod-r8168=y           # Realtek 千兆网卡驱动
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-tulip=y
CONFIG_PACKAGE_kmod-via-velocity=y
CONFIG_PACKAGE_kmod-vmxnet3=y         # VMware 虚拟网卡驱动

# 2. 各类虚拟机专用底层驱动 (PVE / KVM / Hyper-V)
CONFIG_PACKAGE_kmod-hyperv-net=y       # Hyper-V 虚拟机网卡驱动
CONFIG_PACKAGE_kmod-hyperv-storage=y  # Hyper-V 虚拟机磁盘驱动
CONFIG_PACKAGE_kmod-virtio-net=y      # PVE / KVM 半虚拟化网卡驱动 (强烈推荐)
CONFIG_PACKAGE_kmod-virtio-pci=y      # VirtIO PCI 总线驱动
CONFIG_PACKAGE_kmod-virtio-balloon=y  # VirtIO 内存气球驱动
CONFIG_PACKAGE_kmod-scsi-virtio=y     # VirtIO SCSI 硬盘驱动
